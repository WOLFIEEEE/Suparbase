# --------------------------------------------------------------------
# Suparbase environment
# --------------------------------------------------------------------
# Local development:        copy to .env.local and fill in.
# Coolify / Docker Compose: ALL of these are optional. The bootstrap
#                            service auto-generates the three secrets on
#                            first boot. Any value you set in Coolify
#                            wins over the auto-generated default.
# --------------------------------------------------------------------

# --- Local-dev only (Coolify composes DATABASE_URL for you) ---------
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/suparbase

# --- Auto-generated on first deploy if blank ------------------------
# Suparbase will write a 32-byte random secret per missing value into
# the `suparbase_secrets` Docker volume. Same value persists across
# redeploys. ⚠ Losing that volume destroys every encrypted credential
# in the deploy - use Coolify's snapshot feature.
POSTGRES_PASSWORD=
AUTH_SECRET=
SUPARBASE_ENCRYPTION_KEY=

# --- App origin -----------------------------------------------------
# Defaults to https://suparbase.com in docker-compose.yaml. Set this
# explicitly to whatever domain Coolify assigns.
AUTH_URL=https://suparbase.com

# --- Optional: GitHub OAuth (https://github.com/settings/developers)
# Leave both blank for email+password-only sign-in. When set, the
# Sign in page also shows a "Continue with GitHub" button.
# Authorization callback URL must be: ${AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Optional: vault key rotation ----------------------------------
# When you rotate the primary vault key, paste the previous value
# here so existing rows can still be decrypted (then re-saved).
# SUPARBASE_ENCRYPTION_KEY_OLD=

# --- Optional: AI default model -------------------------------------
# Default OpenRouter model for new users. Each user can override.
# SUPARBASE_AI_DEFAULT_MODEL=anthropic/claude-3.5-haiku

# --- Optional: transactional email via Resend ----------------------
# When BOTH are set, Suparbase will email team invitations (v2.4)
# directly. With either missing, the UI falls back to copy-link
# invites - nothing breaks, the owner shares the URL manually.
#
# Get a key at https://resend.com/api-keys. EMAIL_FROM must be a
# verified sender on the domain you've added to Resend, e.g.
# "Suparbase <invites@yourdomain.com>". EMAIL_REPLY_TO is optional.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Suparbase <invites@yourdomain.com>
# EMAIL_REPLY_TO=support@yourdomain.com

# --- Optional: retention cron secret -------------------------------
# When set, /api/cron/retention accepts a daily POST with
# `Authorization: Bearer $CRON_SECRET` to prune old audit_log,
# sentry_scan, sentry_finding (resolved), and agent_session rows.
# Without this, retention is fail-closed - nothing gets pruned and
# the tables grow forever. Generate a 32-byte random secret.
# CRON_SECRET=

# --- Optional: log level -------------------------------------------
# debug | info | warn | error. Defaults to "info" in production and
# "debug" in development. Structured JSON to stdout; collect with
# your log pipeline of choice.
# LOG_LEVEL=info

# --- Optional: Dodo Payments (subscription billing) ----------------
# When DODO_API_KEY is set, /settings/billing exposes the "Start
# 7-day trial" CTA and POST /api/billing/checkout works. Without it,
# the page degrades to a "coming soon" notice and the Free tier
# still functions normally.
#
# Get keys at https://dodopayments.com → Developer → API Keys (test
# mode keys begin with TMP, live keys with sk_live_).
#
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=                   # Dashboard → Developer → Webhooks → Signing secret
# DODO_HOSTED_PRODUCT_ID=pdt_0Nev0FKdzw0UxPeUBKItA
# DODO_HOSTED_ANNUAL_PRODUCT_ID=         # Optional. Publish an annual product in Dodo + set its id here to enable the Monthly/Annual toggle on /settings/billing.
# DODO_MODE=test                         # test (default) | live

# --- Optional: admin panel access ---------------------------------
# CSV of email addresses that can reach /admin (overview, users, audit,
# billing, operations and email diagnostics). Compared lowercased against
# session.user.email. Listed operators must also enable TOTP 2FA. Leave
# empty to disable the admin panel.
#
# SUPARBASE_ADMIN_EMAILS=ops@example.com,founder@example.com

# --- Optional: error reporting ------------------------------------
# When set, /api/health reports `observability: true`. The
# `reportError()` helper in src/server/observability/report.ts is
# the single call site for unhandled errors - point it at Sentry,
# Bugsnag, or your own collector via instrumentation.ts.
#
# SENTRY_DSN=

# --- Optional: product analytics (PostHog) ------------------------
# When the public key is set, src/lib/analytics dynamically loads
# posthog-js on the client and starts capturing page-views + the
# explicit events we instrument (checkout_started, etc.). Without
# the key, analytics is a no-op (zero requests, no JS loaded).
# Respects navigator.doNotTrack.
#
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
