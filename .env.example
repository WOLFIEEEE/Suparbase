# --------------------------------------------------------------------
# Suparbase environment
# Copy this file to .env.local and fill in.
# --------------------------------------------------------------------

# --- App database --------------------------------------------------
# Postgres connection string (Supabase / Neon / local docker).
# Example: postgres://user:pass@host:5432/db
DATABASE_URL=

# --- NextAuth ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public origin of the app (no trailing slash). In dev: http://localhost:3000
AUTH_URL=http://localhost:3000

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: ${AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Credential vault ----------------------------------------------
# 32-byte key, base64-encoded.
# Generate with: openssl rand -base64 32
SUPARBASE_ENCRYPTION_KEY=

# Optional. When you rotate the primary key, put the previous key here
# so we can decrypt rows that were encrypted with it.
# SUPARBASE_ENCRYPTION_KEY_OLD=

# --- AI assistance (optional) -------------------------------------
# Default model for new users. Users can override per-account.
# SUPARBASE_AI_DEFAULT_MODEL=anthropic/claude-3.5-haiku
