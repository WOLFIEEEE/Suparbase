# --------------------------------------------------------------------
# Suparbase environment
# --------------------------------------------------------------------
# Local development:        copy to .env.local and fill in.
# Coolify / Docker Compose: set these in the Coolify env-vars panel.
#
# DATABASE_URL is NOT here on purpose. When deploying via docker-compose
# it is composed inside the compose file from POSTGRES_PASSWORD and the
# internal service name. For local dev only, supply your own DATABASE_URL.
# --------------------------------------------------------------------

# --- Local-dev only (Coolify composes this for you) -----------------
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/suparbase

# --- Database password (used by docker-compose to build DATABASE_URL)
# Coolify: click "Generate" — a strong random value.
POSTGRES_PASSWORD=

# --- NextAuth -------------------------------------------------------
# Coolify: click "Generate" — any 32+ bytes of entropy.
AUTH_SECRET=

# The PUBLIC origin your users will visit. No trailing slash.
# Coolify: copy from the "Domains" section of this resource.
AUTH_URL=http://localhost:3000

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL must be: ${AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Credential vault (Supabase keys + OpenRouter keys at rest) -----
# Coolify: click "Generate" — 32 raw bytes, base64-encoded.
# Local: openssl rand -base64 32
SUPARBASE_ENCRYPTION_KEY=

# Optional. When you rotate the primary vault key, paste the previous
# value here so existing rows can still be decrypted (then re-saved).
# SUPARBASE_ENCRYPTION_KEY_OLD=

# --- AI assistance (optional) ---------------------------------------
# Default model for new users. Each user can override per-account.
# SUPARBASE_AI_DEFAULT_MODEL=anthropic/claude-3.5-haiku
